NODE_ENV=development
PORT=3001
LOG_LEVEL=log
SWAGGER_ENABLED=true
TRUST_PROXY=false
DATABASE_AUTO_MIGRATE=true
BOOTSTRAP_SUPER_ADMIN=false
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_secure_password
SUPER_ADMIN_NAME=Victrium RH Admin

# Optional: use DATABASE_URL instead of the split DB_* fields below.
# DATABASE_URL=mysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@YOUR_MYSQL_HOST:3306/YOUR_MYSQL_DATABASE

DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_NAME=YOUR_MYSQL_DATABASE
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD

JWT_ACCESS_SECRET=change-me-use-at-least-32-characters
JWT_REFRESH_SECRET=change-me-use-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=https://victrium-rh-fichaje-web.victriumtech.com,https://*.victriumtech.com,http://localhost:3000
TZ=Europe/Madrid

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
